diff --git a/pkg/djible/context_stop.go b/pkg/djible/context_stop.go
new file mode 100644
index 0000000..637e857
--- /dev/null
+++ b/pkg/djible/context_stop.go
@@ -0,0 +1,19 @@
+package djible
+
+import "context"
+
+// SIGTERM等を受けてもBLEの下位トランスポート(gatt.Device)を握っているctxそのものは
+// キャンセルしない。ctxをキャンセルすると Scan() で作られた gatt.Device ごと切断され、
+// その後に送ろうとするStopLiveStream等のBLE書き込みも失敗するため
+// (実機検証で "context deadline exceeded" として確認済み)。
+// 代わりに「停止要求が来たこと」だけをこのチャンネルで伝える。
+type stopRequestedCtxKey struct{}
+
+func WithStopRequested(ctx context.Context, ch <-chan struct{}) context.Context {
+	return context.WithValue(ctx, stopRequestedCtxKey{}, ch)
+}
+
+func StopRequestedFromContext(ctx context.Context) <-chan struct{} {
+	ch, _ := ctx.Value(stopRequestedCtxKey{}).(<-chan struct{})
+	return ch
+}
