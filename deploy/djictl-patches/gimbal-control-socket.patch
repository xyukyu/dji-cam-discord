diff --git a/pkg/djible/interface_app_to_gimbal_speed.go b/pkg/djible/interface_app_to_gimbal_speed.go
new file mode 100644
index 0000000..47ebc0d
--- /dev/null
+++ b/pkg/djible/interface_app_to_gimbal_speed.go
@@ -0,0 +1,51 @@
+package djible
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+
+	"github.com/xaionaro-go/djictl/pkg/duml"
+)
+
+// SetSpeed instructs the gimbal to rotate at the given angular speeds
+// (degrees/sec per axis) until overridden by a new command.
+//
+// このコマンドはコミュニティのリバースエンジニアリング成果(yigitkonur/lib-osmo-ble)を
+// 元にしており、実機での効果は未確認(BLE経由ではカメラがコマンドを無視し、
+// ACKも一切返さないという報告がある。詳細はdeploy/djictl-patches/README.md参照)。
+func (s *InterfaceAppToGimbal) SetSpeed(
+	ctx context.Context,
+	pitchDegPerSec, rollDegPerSec, yawDegPerSec float64,
+) error {
+	msg := &duml.Message{
+		Interface: s.InterfaceID(),
+		ID:        duml.MessageIDGimbalSpeedControl,
+		Type:      duml.MessageTypeGimbalSpeedControl,
+		Payload:   s.getMessagePayloadSpeed(pitchDegPerSec, rollDegPerSec, yawDegPerSec),
+	}
+	if err := s.Device().SendMessage(ctx, msg, true); err != nil {
+		return fmt.Errorf("unable to send the gimbal speed command: %w", err)
+	}
+	return nil
+}
+
+func (s *InterfaceAppToGimbal) getMessagePayloadSpeed(
+	pitchDegPerSec, rollDegPerSec, yawDegPerSec float64,
+) []byte {
+	var buf bytes.Buffer
+	must(buf.Write(int16LEBytes(pitchDegPerSec * 10)))
+	must(buf.Write(int16LEBytes(rollDegPerSec * 10)))
+	must(buf.Write(int16LEBytes(yawDegPerSec * 10)))
+	var flags byte
+	if pitchDegPerSec != 0 || rollDegPerSec != 0 || yawDegPerSec != 0 {
+		flags = 0x01
+	}
+	must(buf.Write([]byte{flags}))
+	return buf.Bytes()
+}
+
+func int16LEBytes(v float64) []byte {
+	i := int16(v)
+	return []byte{byte(i), byte(i >> 8)}
+}
