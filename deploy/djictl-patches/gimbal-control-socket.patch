diff --git a/pkg/djible/context_gimbal_control.go b/pkg/djible/context_gimbal_control.go
new file mode 100644
index 0000000..264b30c
--- /dev/null
+++ b/pkg/djible/context_gimbal_control.go
@@ -0,0 +1,23 @@
+package djible
+
+import "context"
+
+// ジンバル操作コマンドを配信ループ(LiveStream)に伝えるためのチャンネル。
+// stopRequestedと同じ理由(BLE接続を握るctxはキャンセルできない)で、
+// ctx.Value経由でチャンネルだけを運ぶ。
+type GimbalSpeedCommand struct {
+	PitchDegPerSec float64
+	RollDegPerSec  float64
+	YawDegPerSec   float64
+}
+
+type gimbalControlRequestedCtxKey struct{}
+
+func WithGimbalControlRequested(ctx context.Context, ch <-chan GimbalSpeedCommand) context.Context {
+	return context.WithValue(ctx, gimbalControlRequestedCtxKey{}, ch)
+}
+
+func GimbalControlRequestedFromContext(ctx context.Context) <-chan GimbalSpeedCommand {
+	ch, _ := ctx.Value(gimbalControlRequestedCtxKey{}).(<-chan GimbalSpeedCommand)
+	return ch
+}
