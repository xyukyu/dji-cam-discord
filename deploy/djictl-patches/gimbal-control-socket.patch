+// listenGimbalControlSocket は、配信中に外部プロセス(Bot)からジンバル操作コマンドを
+// 受け取るためのUnixドメインソケットをリッスンする。コマンドは改行区切りのJSON
+// ({"PitchDegPerSec":..,"RollDegPerSec":..,"YawDegPerSec":..})を想定する。
+func listenGimbalControlSocket(ctx context.Context, socketPath string) (chan djible.GimbalSpeedCommand, error) {
+	// 前回異常終了時のソケットファイルの残骸を掃除してからリッスンする。
+	_ = os.Remove(socketPath)
+	l, err := net.Listen("unix", socketPath)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(socketPath, 0600); err != nil {
+		logger.Errorf(ctx, "unable to chmod the control socket %q: %v", socketPath, err)
+	}
+
+	ch := make(chan djible.GimbalSpeedCommand, 8)
+	go func() {
+		defer l.Close()
+		for {
+			conn, err := l.Accept()
+			if err != nil {
+				logger.Debugf(ctx, "control socket accept loop stopped: %v", err)
+				return
+			}
+			go handleGimbalControlConn(ctx, conn, ch)
+		}
+	}()
+	return ch, nil
+}
+
+func handleGimbalControlConn(ctx context.Context, conn net.Conn, ch chan<- djible.GimbalSpeedCommand) {
+	defer conn.Close()
+	dec := json.NewDecoder(conn)
+	for {
+		var cmd djible.GimbalSpeedCommand
+		if err := dec.Decode(&cmd); err != nil {
+			return
+		}
+		select {
+		case ch <- cmd:
+		default:
+			logger.Debugf(ctx, "gimbal control channel is full; dropping a command")
+		}
+	}
+}
