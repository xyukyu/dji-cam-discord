# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# カメラ(Osmo Pocket 3)
CAMERA_BLE_ADDRESS=
HOME_WIFI_SSID=
HOME_WIFI_PASSWORD=
# 注意: 127.0.0.1はカメラ自身の自己参照になってしまうため使用不可。
# 必ずラズパイのLAN上の実IPアドレスを指定すること(例: 192.168.1.43)。
RTMP_URL=rtmp://192.168.1.43:1935/pocket3

# djictl バイナリのパス(絶対パス推奨)
DJICTL_PATH=/home/<your-user>/dji-cam-discord/bin/djictl

# MediaMTXからのwebhookを受信するローカルポート(mediamtx.ymlの設定と一致させる)
WEBHOOK_PORT=3100

# 視聴ページの公開URL(Cloudflare Tunnelのホスト名)。末尾スラッシュなし
VIEWER_BASE_URL=https://example.trycloudflare.com
