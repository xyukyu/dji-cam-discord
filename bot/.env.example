# Discord
# DISCORD_CLIENT_ID はスラッシュコマンドのグローバル登録(deploy-commands.js)にのみ使う。
# ギルドID/チャンネルIDは不要(通知先は直近で /cam start を実行したチャンネルを自動で使う)。
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# カメラ(Osmo Pocket 3)
CAMERA_BLE_ADDRESS=
HOME_WIFI_SSID=
HOME_WIFI_PASSWORD=
# 注意: 127.0.0.1はカメラ自身の自己参照になってしまうため使用不可。
# 必ずラズパイのLAN上の実IPアドレスを指定すること(例: 192.168.1.100)。
RTMP_URL=rtmp://192.168.1.100:1935/pocket3

# djictl バイナリのパス(絶対パス推奨)
DJICTL_PATH=/home/<your-user>/dji-cam-discord/bin/djictl

# MediaMTXからのwebhookを受信するローカルポート(mediamtx.ymlの設定と一致させる)
WEBHOOK_PORT=3100

# 視聴ページの公開URL。通常は不要(cloudflaredのローカルmetricsサーバーから
# 配信開始のたびに現在有効なホスト名を自動取得するため)。取得に失敗した場合の
# フォールバック用に設定しておくと安全(古いURLになりがちなので基本は空でよい)。
VIEWER_BASE_URL=

# cloudflaredのmetricsサーバーのURL(Quick Tunnelのホスト名を取得する先)。
# 通常は変更不要。deploy/cloudflared.serviceで--metrics localhost:20241を指定している。
CLOUDFLARED_METRICS_URL=http://127.0.0.1:20241/quicktunnel

# 視聴ページ(viewer/index.html)を配信するサーバーのローカルポート。
# deploy/cloudflared.serviceの--urlと一致させること(このポートを外部公開する)。
VIEWER_PUBLIC_PORT=3200

# 視聴ページの操作パネル(配信開始/停止・画質変更)用の簡易パスワード。
# 視聴ページのURLはCloudflare Tunnel経由で誰でも開けるため、操作には別途これが必要。
# 十分に長いランダム文字列を設定すること(視聴自体には不要、操作時のみ入力する)。
VIEWER_CONTROL_PASSWORD=

# YouTube Live連携(任意機能、既定オフ)。有効にする場合は
# bot/scripts/youtube-oauth-setup.js を一度だけ実行してYOUTUBE_REFRESH_TOKENを取得すること。
# 対象チャンネルは事前にYouTube側でライブ配信を有効化(電話番号確認、反映まで最大24時間)
# しておく必要がある。詳細はdeploy/NOTES.md参照。
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public/unlisted/private。privateにすると視聴を許可した特定のGoogleアカウント以外は
# URLを知っていても視聴できない(unlistedは逆にURLを知っていれば誰でも視聴可能)。
# privateを使う場合、配信(broadcast)は/cam startのたびに新規作成されるため、
# 視聴者のGoogleアカウントをYouTube Studio側で毎回(または都度)共有設定する必要がある。
YOUTUBE_PRIVACY_STATUS=unlisted

# ffmpegバイナリのパス(YOUTUBE_ENABLED=trueの場合のみ使用、中継処理に必要)
FFMPEG_PATH=ffmpeg
